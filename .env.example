# Código que toda la familia escribe para entrar a la app (elijan uno que no sea fácil de adivinar)
FAMILY_CODE=cambia-este-codigo

# Nombres de la familia, separados por comas (los espacios alrededor de las comas no importan).
# Si se llena, la lista queda fija: nadie puede agregarse ni quitarse desde la app.
# Para cambiarla, se edita aquí (o en Vercel) y se vuelve a desplegar.
# Déjenlo vacío si prefieren que cada quien se agregue solo desde la app.
FAMILY_MEMBERS=Gabriel, María José, Tía Ana, Luis

# Quiénes pueden entrar a Medicinas → Horario y Familia (separados por comas).
# Si se deja vacío, son Gabriel, Bosco y Marianne. Inventario lo puede usar cualquiera.
ADMIN_MEMBERS=Gabriel, Bosco, Marianne

# Base de datos Turso (créala aparte de la de otros proyectos)
TURSO_DATABASE_URL=libsql://pastillero-tu-usuario.turso.io
TURSO_AUTH_TOKEN=

# Recordatorios por notificación. Las dos llaves se generan con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un correo de contacto (lo piden los servicios de notificaciones de Apple y Google)
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Clave para la revisión automática de recordatorios (cron cada 5 minutos). Inventen una larga.
CRON_SECRET=una-clave-larga-y-dificil

# Zona horaria de la familia, para mandar los avisos a la hora correcta
APP_TIMEZONE=America/Costa_Rica
